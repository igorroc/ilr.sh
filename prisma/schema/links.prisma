model Link {
  id             String    @id @default(cuid())
  userId         String
  title          String?
  slug           String    @unique
  destinationUrl String
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bioLinks BioLink[]

  @@index([userId, createdAt])
}

model BioPage {
  id          String  @id @default(cuid())
  name        String
  headline    String?
  description String?
  isPublished Boolean @default(false)
  topics      Json    @default("[]")

  ctaLabel String?
  ctaUrl   String?

  quote            String?
  quoteAccentColor String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  links BioLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BioLink {
  id             String   @id @default(cuid())
  pageId         String
  title          String
  description    String?
  accentColor    String?
  linkId         String?
  destinationUrl String?
  sortOrder      Int
  isVisible      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  page BioPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  link Link?   @relation(fields: [linkId], references: [id], onDelete: Restrict)

  @@index([pageId, sortOrder])
  @@index([linkId])
}
